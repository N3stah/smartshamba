generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model County {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String        @unique
  wards        Ward[]
  farmers      Farmer[]
  buyers       Buyer[]
  farmerGroups FarmerGroup[]
  createdAt    DateTime      @default(now())
  advisories             Advisory[]
}

model Ward {
  id           String        @id @default(cuid())
  name         String
  countyId     String
  county       County        @relation(fields: [countyId], references: [id], onDelete: Cascade)
  farmers      Farmer[]
  buyers       Buyer[]
  farmerGroups FarmerGroup[]
  createdAt    DateTime      @default(now())

  @@unique([countyId, name])
}

model Farmer {
  language        String   @default("en") // i18n: "en" | "sw"
  id          String   @id @default(cuid())
  nationalId  String?  // KYC-lite: 8-digit Kenya National ID
  password    String?
  verified    Boolean  @default(false)
  phone     String   @unique
  name      String?
  location  String?
  countyId  String?
  wardId    String?
  village   String?
  createdAt DateTime @default(now())

  transactions Transaction[]
  ratings      Rating[]
  disputes     Dispute[]

  county County? @relation(fields: [countyId], references: [id])
  ward   Ward?   @relation(fields: [wardId], references: [id])

  createdGroups    FarmerGroup[] @relation("GroupCreator")
  groupMemberships GroupMember[]

  notifications          Notification[]
  notificationPreference NotificationPreference?
  ProduceListing        ProduceListing[]
}

model Buyer {
  phone           String? @unique // Added for USSD/OTP login
  password    String?
  language        String   @default("en") // i18n: "en" | "sw"
  id           String    @id @default(cuid())
  name         String
  location     String
  verified     Boolean   @default(false)
  capacityBags Int
  pricePerBag  Float
  active       Boolean   @default(true)
  countyId     String?
  wardId       String?
  village      String?
  createdAt    DateTime? @default(now()) @db.Timestamptz(6)

  transactions      Transaction[]
  ratings           Rating[]
  disputes          Dispute[]
  groupTransactions GroupTransaction[]

  county County? @relation(fields: [countyId], references: [id])
  ward   Ward?   @relation(fields: [wardId], references: [id])
  notifications          Notification[]
  BuyerDemand           BuyerDemand[]
}

model Transaction {
  id           String   @id @default(cuid())
  farmerId     String
  buyerId      String
  produceListingId String?
  buyerDemandId    String?
  conversation    Conversation?
  b2cPayout       B2CPayout?
  createdAt    DateTime @default(now())
  mpesaRef     String?
  pricePerBag  Float
  quantityBags Int
  reference    String   @unique
  totalValue   Float
  status          TxStatus @default(PENDING)
  deliveryMethod  String?  // "PICKUP" | "DELIVERY"
  deliveryLocation String?
  scheduledDate   DateTime?
  fulfillmentNotes String?
  platformFee     Float    @default(0)
  b2cRef          String?  // M-PESA B2C ConversationID

  buyer  Buyer  @relation(fields: [buyerId], references: [id])
  farmer Farmer @relation(fields: [farmerId], references: [id])

  ratings Rating[]
  dispute Dispute?
  qualityAssessment      QualityAssessment?
  @@index([createdAt])
  @@index([buyerId])
  @@index([farmerId])
  @@index([reference])
}

model FarmerGroup {
  id          String  @id @default(cuid())
  name        String
  description String?
  whatsappLink String?

  countyId String?
  wardId   String?
  village  String?

  createdById String

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  county County? @relation(fields: [countyId], references: [id])
  ward   Ward?   @relation(fields: [wardId], references: [id])

  createdBy Farmer @relation("GroupCreator", fields: [createdById], references: [id])

  members      GroupMember[]
  transactions GroupTransaction[]

  @@index([countyId])
  @@index([wardId])
  @@index([active])
}

model GroupMember {
  id String @id @default(cuid())

  groupId  String
  farmerId String

  bagsPledged Int @default(0)

  joinedAt DateTime @default(now())

  group  FarmerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  farmer Farmer      @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@unique([groupId, farmerId], name: "groupId_farmerId")
  @@index([farmerId])
}

model GroupTransaction {
  id String @id @default(cuid())

  groupId String
  buyerId String

  reference String @unique

  totalBags   Int
  pricePerBag Float
  totalValue  Float

  status TxStatus @default(PENDING)

  createdAt DateTime @default(now())

  group FarmerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  buyer Buyer       @relation(fields: [buyerId], references: [id])

  @@index([groupId])
  @@index([buyerId])
}

model UssdSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  phone     String
  state     Int      @default(0)
  data      Json?
  updatedAt DateTime @updatedAt
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

enum TxStatus {
  PENDING
  AGREED
  DELIVERY_SCHEDULED
  CONFIRMED
  DELIVERED
  SETTLING
  SETTLED
  CLOSED
  DISPUTED
}

enum RaterType {
  FARMER
  BUYER
}

enum DisputeReason {
  QUANTITY_MISMATCH
  QUALITY_REJECTED
  PAYMENT_DELAY
  BUYER_UNRESPONSIVE
  PRICE_CHANGED
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

model Rating {
  id            String    @id @default(cuid())
  transactionId String
  farmerId      String
  buyerId       String
  raterType     RaterType
  score         Int
  comment       String?
  createdAt     DateTime  @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
  farmer      Farmer      @relation(fields: [farmerId], references: [id])
  buyer       Buyer       @relation(fields: [buyerId], references: [id])

  @@unique([transactionId, raterType])
  @@index([buyerId])
  @@index([farmerId])
}

model Dispute {
  adminNotes      String?  // Internal notes for escalated disputes
  id            String        @id @default(cuid())
  transactionId String        @unique
  farmerId      String
  buyerId       String
  reason        DisputeReason
  description   String?
  status        DisputeStatus @default(OPEN)
  adminNote     String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id])
  farmer      Farmer      @relation(fields: [farmerId], references: [id])
  buyer       Buyer       @relation(fields: [buyerId], references: [id])

  @@index([farmerId])
  @@index([buyerId])
  @@index([transactionId])
}

enum NotificationType {
  TRANSACTION_CONFIRMATION
  SETTLEMENT
  WEEKLY_MARKET_REPORT
  HARVEST_ADVISORY
  QUALITY_ADVISORY
  DISPUTE_UPDATE
  OTP
  GROUP_TRANSACTION
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

model Notification {
  id               String             @id @default(cuid())
  type             NotificationType
  recipientPhone   String
  farmerId         String?
  buyerId          String?
  body             String
  status           NotificationStatus @default(PENDING)
  providerResponse String?
  retries          Int                @default(0)
  sentAt           DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  farmer           Farmer?            @relation(fields: [farmerId], references: [id])
  buyer            Buyer?             @relation(fields: [buyerId], references: [id])

  @@index([farmerId])
  @@index([type])
  @@index([createdAt])
  @@index([recipientPhone])
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  farmerId           String   @unique
  transactionSms     Boolean  @default(true)
  weeklyMarketReport Boolean  @default(true)
  harvestTips        Boolean  @default(true)
  qualityAlerts      Boolean  @default(true)
  disputeUpdates     Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  farmer             Farmer   @relation(fields: [farmerId], references: [id])
}

model Advisory {
  id        String   @id @default(cuid())
  title     String
  message   String
  countyId  String?
  startDate DateTime
  endDate   DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  county    County?  @relation(fields: [countyId], references: [id])

  @@index([active])
  @@index([countyId])
}

model QualityAssessment {
  id             String      @id @default(cuid())
  transactionId  String      @unique
  moistureAnswer String?
  grainColour    String?
  brokenGrain    String?
  foreignMatter  String?
  notes          String?
  createdAt      DateTime    @default(now())

  transaction    Transaction @relation(fields: [transactionId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // e.g. "SETTLE_TRANSACTION", "UPDATE_BUYER", "RESOLVE_DISPUTE"
  actorType  String   // "ADMIN" | "SYSTEM"
  actorId    String?  // admin identifier (phone or email)
  entityType String   // "Transaction" | "Buyer" | "Dispute" etc.
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
  
  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@index([createdAt])
}

model ProduceListing {
  id           String   @id @default(cuid())
  farmerId     String
  product      String   // e.g., "Maize", "Beans"
  quantityBags Int
  pricePerBag  Float
  status       String   @default("ACTIVE") // ACTIVE, CLOSED
  createdAt    DateTime @default(now())
  farmer       Farmer   @relation(fields: [farmerId], references: [id])
  @@index([farmerId])
}

model BuyerDemand {
  id           String   @id @default(cuid())
  buyerId      String
  product      String
  quantityBags Int
  location     String
  status       String   @default("ACTIVE") // ACTIVE, CLOSED
  createdAt    DateTime @default(now())
  buyer        Buyer    @relation(fields: [buyerId], references: [id])
  @@index([buyerId])
}


model Conversation {
  id             String       @id @default(cuid())
  transactionId  String       @unique
  transaction    Transaction  @relation(fields: [transactionId], references: [id])
  messages       Message[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderType     String       // "FARMER" | "BUYER"
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}


model B2CPayout {
  id                    String   @id @default(cuid())
  transactionId         String   @unique
  transaction           Transaction @relation(fields: [transactionId], references: [id])
  conversationId        String?  // Safaricom ConversationID
  originatorConversationID String? // Safaricom OriginatorConversationID
  amount                Float
  status                String   @default("PENDING") // PENDING, SUCCESS, FAILED
  mpesaRef              String?  // M-PESA Transaction ID if successful
  failureReason         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}


model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   // Generic ID (Farmer ID or Buyer ID)
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())
}
