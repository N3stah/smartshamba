generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model County {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  wards     Ward[]
  farmers   Farmer[]
  buyers    Buyer[]
  createdAt DateTime @default(now())
}

model Ward {
  id        String   @id @default(cuid())
  name      String
  countyId  String
  county    County   @relation(fields: [countyId], references: [id], onDelete: Cascade)
  farmers   Farmer[]
  buyers    Buyer[]
  createdAt DateTime @default(now())

  @@unique([countyId, name])
}

model Farmer {
  id           String        @id @default(cuid())
  phone        String        @unique
  name         String?
  location     String?
  countyId     String?
  wardId       String?
  village      String?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  ratings      Rating[]
  disputes     Dispute[]
  county       County?       @relation(fields: [countyId], references: [id])
  ward         Ward?         @relation(fields: [wardId], references: [id])
}

model Buyer {
  id           String        @id @default(cuid())
  name         String
  location     String
  verified     Boolean       @default(false)
  capacityBags Int
  pricePerBag  Float
  active       Boolean       @default(true)
  countyId     String?
  wardId       String?
  village      String?
  createdAt    DateTime?     @default(now()) @db.Timestamptz(6)
  transactions Transaction[]
  ratings      Rating[]
  disputes     Dispute[]
  county       County?       @relation(fields: [countyId], references: [id])
  ward         Ward?         @relation(fields: [wardId], references: [id])
}

model Transaction {
  id           String    @id @default(cuid())
  farmerId     String
  buyerId      String
  createdAt    DateTime  @default(now())
  mpesaRef     String?
  pricePerBag  Float
  quantityBags Int
  reference    String    @unique
  totalValue   Float
  status       TxStatus  @default(PENDING)
  buyer        Buyer     @relation(fields: [buyerId], references: [id])
  farmer       Farmer    @relation(fields: [farmerId], references: [id])
  ratings      Rating[]
  dispute      Dispute?
}

model UssdSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  phone     String
  state     Int      @default(0)
  data      Json?
  updatedAt DateTime @updatedAt
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

enum TxStatus {
  PENDING
  CONFIRMED
  DELIVERED
  SETTLED
  DISPUTED
}

enum RaterType {
  FARMER
  BUYER
}

enum DisputeReason {
  QUANTITY_MISMATCH
  QUALITY_REJECTED
  PAYMENT_DELAY
  BUYER_UNRESPONSIVE
  PRICE_CHANGED
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

model Rating {
  id            String      @id @default(cuid())
  transactionId String
  farmerId      String
  buyerId       String
  raterType     RaterType
  score         Int
  comment       String?
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  farmer        Farmer      @relation(fields: [farmerId], references: [id])
  buyer         Buyer       @relation(fields: [buyerId], references: [id])

  @@unique([transactionId, raterType])
  @@index([buyerId])
  @@index([farmerId])
}

model Dispute {
  id            String        @id @default(cuid())
  transactionId String        @unique
  farmerId      String
  buyerId       String
  reason        DisputeReason
  description   String?
  status        DisputeStatus @default(OPEN)
  adminNote     String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  farmer        Farmer        @relation(fields: [farmerId], references: [id])
  buyer         Buyer         @relation(fields: [buyerId], references: [id])

  @@index([status])
  @@index([farmerId])
  @@index([buyerId])
}
