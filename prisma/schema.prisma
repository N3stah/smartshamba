generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model County {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String              @unique
  wards              Ward[]
  farmers            Farmer[]
  buyers             Buyer[]
  farmerGroups       FarmerGroup[]
  transportProviders TransportProvider[]
  transportPickups   TransportBooking[]  @relation("TransportPickupCounty")
  transportDropoffs  TransportBooking[]  @relation("TransportDropoffCounty")
  weatherAlerts      WeatherAlert[]      @relation("WeatherAlertCounty")
  advisories         Advisory[]
  createdAt          DateTime            @default(now())
}

model Ward {
  id           String        @id @default(cuid())
  name         String
  countyId     String
  county       County        @relation(fields: [countyId], references: [id], onDelete: Cascade)
  farmers      Farmer[]
  buyers       Buyer[]
  farmerGroups FarmerGroup[]
  createdAt    DateTime      @default(now())

  @@unique([countyId, name])
}

model Farmer {
  farmCropCycles       FarmCropCycle[]
  latitude             Float?
  longitude            Float?
  isFrozen             Boolean                   @default(false)
  frozenReason         String?
  frozenAt             DateTime?
  transportBookings    TransportBooking[]
  contractsAsSeller    Contract[]                @relation("ContractSeller")
  transportAllocations TransportCostAllocation[]
  wallet               Wallet?                   @relation("FarmerWallet")
  aiInsights           AIInsight[]               @relation("FarmerAIInsights")
  language             String                    @default("en") // i18n: "en" | "sw"
  id                   String                    @id @default(cuid())
  nationalId           String? // KYC-lite: 8-digit Kenya National ID
  password             String?
  verified             Boolean                   @default(false)
  phone                String                    @unique
  name                 String?
  location             String?
  countyId             String?
  wardId               String?
  village              String?
  createdAt            DateTime                  @default(now())

  transactions Transaction[]
  ratings      Rating[]
  disputes     Dispute[]

  county County? @relation(fields: [countyId], references: [id])
  ward   Ward?   @relation(fields: [wardId], references: [id])

  createdGroups    FarmerGroup[] @relation("GroupCreator")
  groupMemberships GroupMember[]

  notifications          Notification[]
  notificationPreference NotificationPreference?
  ProduceListing         ProduceListing[]
  smartshambaId          String?                 @unique
  email                  String?
  pin                    String?
  pinFailedAttempts      Int                     @default(0)
  pinLockedUntil         DateTime?
  subscriptions          Subscription[]
}

model Buyer {
  latitude               Float?
  longitude              Float?
  isFrozen               Boolean                 @default(false)
  frozenReason           String?
  frozenAt               DateTime?
  contractsAsBuyer       Contract[]              @relation("ContractBuyer")
  wallet                 Wallet?                 @relation("BuyerWallet")
  aiInsights             AIInsight[]             @relation("BuyerAIInsights")
  notificationPreference NotificationPreference?
  phone                  String?                 @unique // Added for USSD/OTP login
  password               String?
  language               String                  @default("en") // i18n: "en" | "sw"
  id                     String                  @id @default(cuid())
  name                   String
  location               String
  verified               Boolean                 @default(false)
  capacityBags           Int
  pricePerBag            Float
  active                 Boolean                 @default(true)
  countyId               String?
  wardId                 String?
  village                String?
  createdAt              DateTime?               @default(now()) @db.Timestamptz(6)

  transactions      Transaction[]
  ratings           Rating[]
  disputes          Dispute[]
  groupTransactions GroupTransaction[]

  county            County?        @relation(fields: [countyId], references: [id])
  ward              Ward?          @relation(fields: [wardId], references: [id])
  notifications     Notification[]
  BuyerDemand       BuyerDemand[]
  smartshambaId     String?        @unique
  email             String?
  nationalId        String?
  poBox             String?
  pin               String?
  pinFailedAttempts Int            @default(0)
  pinLockedUntil    DateTime?
  subscriptions     Subscription[]
}

model Transaction {
  transportBooking  TransportBooking?
  transportRequest  TransportRequest?
  negotiationOffers NegotiationOffer[]
  contract          Contract?
  ledgerEntries     LedgerEntry[]
  id                String             @id @default(cuid())
  farmerId          String
  buyerId           String
  produceListingId  String?
  buyerDemandId     String?
  conversation      Conversation?
  b2cPayout         B2CPayout?
  createdAt         DateTime           @default(now())
  mpesaRef          String?
  pricePerBag       Float
  quantityBags      Int
  reference         String             @unique
  totalValue        Float
  status            TxStatus           @default(PENDING)
  deliveryMethod    String? // "PICKUP" | "DELIVERY"
  deliveryLocation  String?
  scheduledDate     DateTime?
  fulfillmentNotes  String?
  platformFee       Float              @default(0)
  b2cRef            String? // M-PESA B2C ConversationID

  buyer  Buyer  @relation(fields: [buyerId], references: [id])
  farmer Farmer @relation(fields: [farmerId], references: [id])

  ratings           Rating[]
  dispute           Dispute?
  qualityAssessment QualityAssessment?

  @@index([createdAt])
  @@index([buyerId])
  @@index([farmerId])
  @@index([reference])
}

model FarmerGroup {
  id           String  @id @default(cuid())
  name         String
  description  String?
  whatsappLink String?

  countyId String?
  wardId   String?
  village  String?

  createdById String

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  county County? @relation(fields: [countyId], references: [id])
  ward   Ward?   @relation(fields: [wardId], references: [id])

  createdBy Farmer @relation("GroupCreator", fields: [createdById], references: [id])

  members          GroupMember[]
  transactions     GroupTransaction[]
  verified         Boolean            @default(false)
  whatsappApproved Boolean            @default(false)
  warehouses       Warehouse[]        @relation("WarehouseGroup")

  @@index([countyId])
  @@index([wardId])
  @@index([active])
}

model GroupMember {
  id String @id @default(cuid())

  groupId  String
  farmerId String

  bagsPledged Int @default(0)

  joinedAt DateTime @default(now())

  group  FarmerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  farmer Farmer      @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@unique([groupId, farmerId], name: "groupId_farmerId")
  @@index([farmerId])
}

model GroupTransaction {
  transportBookings TransportBooking[] @relation("TransportBookings")
  transportRequests TransportRequest[]
  id                String             @id @default(cuid())

  groupId String
  buyerId String

  reference String @unique

  totalBags   Int
  pricePerBag Float
  totalValue  Float

  status TxStatus @default(PENDING)

  createdAt DateTime @default(now())

  group FarmerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  buyer Buyer       @relation(fields: [buyerId], references: [id])

  @@index([groupId])
  @@index([buyerId])
}

model UssdSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  phone     String
  state     Int      @default(0)
  data      Json?
  updatedAt DateTime @updatedAt
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

enum TxStatus {
  PENDING
  AGREED
  DELIVERY_SCHEDULED
  CONFIRMED
  DELIVERED
  SETTLING
  SETTLED
  CLOSED
  DISPUTED
}

enum RaterType {
  FARMER
  BUYER
}

enum DisputeReason {
  QUANTITY_MISMATCH
  QUALITY_REJECTED
  PAYMENT_DELAY
  BUYER_UNRESPONSIVE
  PRICE_CHANGED
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

model Rating {
  id            String    @id @default(cuid())
  transactionId String
  farmerId      String
  buyerId       String
  raterType     RaterType
  score         Int
  comment       String?
  createdAt     DateTime  @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
  farmer      Farmer      @relation(fields: [farmerId], references: [id])
  buyer       Buyer       @relation(fields: [buyerId], references: [id])

  @@unique([transactionId, raterType])
  @@index([buyerId])
  @@index([farmerId])
}

model Dispute {
  dealEvidenceId String?
  resolution     String?       @db.Text
  adminNotes     String? // Internal notes for escalated disputes
  id             String        @id @default(cuid())
  transactionId  String        @unique
  farmerId       String
  buyerId        String
  reason         DisputeReason
  description    String?
  status         DisputeStatus @default(OPEN)
  adminNote      String?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id])
  farmer      Farmer      @relation(fields: [farmerId], references: [id])
  buyer       Buyer       @relation(fields: [buyerId], references: [id])

  @@index([farmerId])
  @@index([buyerId])
  @@index([transactionId])
}

enum NotificationType {
  TRANSACTION_CONFIRMATION
  SETTLEMENT
  WEEKLY_MARKET_REPORT
  HARVEST_ADVISORY
  QUALITY_ADVISORY
  DISPUTE_UPDATE
  OTP
  GROUP_TRANSACTION
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

model Notification {
  id               String             @id @default(cuid())
  type             NotificationType
  recipientPhone   String
  farmerId         String?
  buyerId          String?
  providerId       String?
  body             String
  status           NotificationStatus @default(PENDING)
  providerResponse String?
  retries          Int                @default(0)
  deliveryKey      String?            @unique
  sentAt           DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  farmer   Farmer?            @relation(fields: [farmerId], references: [id])
  buyer    Buyer?             @relation(fields: [buyerId], references: [id])
  provider TransportProvider? @relation(fields: [providerId], references: [id])

  @@index([farmerId])
  @@index([type])
  @@index([createdAt])
  @@index([recipientPhone])
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  farmerId           String?  @unique
  buyerId            String?  @unique
  providerId         String?  @unique
  transactionSms     Boolean  @default(true)
  weeklyMarketReport Boolean  @default(true)
  harvestTips        Boolean  @default(true)
  qualityAlerts      Boolean  @default(true)
  buyerDemandAlerts  Boolean  @default(true)
  weatherAlerts      Boolean  @default(true)
  disputeUpdates     Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  farmer   Farmer?            @relation(fields: [farmerId], references: [id])
  buyer    Buyer?             @relation(fields: [buyerId], references: [id])
  provider TransportProvider? @relation(fields: [providerId], references: [id])
}

model Advisory {
  id        String   @id @default(cuid())
  title     String
  message   String
  countyId  String?
  startDate DateTime
  endDate   DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  language  String   @default("en")

  county County? @relation(fields: [countyId], references: [id])

  @@index([active])
  @@index([countyId])
}

model QualityAssessment {
  farmBatches    FarmBatch[]
  id             String      @id @default(cuid())
  transactionId  String?     @unique
  moistureAnswer String?
  grainColour    String?
  brokenGrain    String?
  foreignMatter  String?
  notes          String?
  createdAt      DateTime    @default(now())

  transaction      Transaction?    @relation(fields: [transactionId], references: [id])
  produceListingId String?
  produceListing   ProduceListing? @relation("ListingQuality", fields: [produceListingId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String // e.g. "SETTLE_TRANSACTION", "UPDATE_BUYER", "RESOLVE_DISPUTE"
  actorType  String // "STAFF" | "SYSTEM"
  actorId    String? // Staff ID
  staffId    String?
  staff      Staff?   @relation(fields: [staffId], references: [id])
  entityType String // "Transaction" | "Buyer" | "Dispute" etc.
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String? // IP address of the actor
  userAgent  String? // User agent of the actor
  reason     String? // Reason for override
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@index([createdAt])
}

model ProduceListing {
  id                 String              @id @default(cuid())
  farmerId           String
  product            String // e.g., "Maize", "Beans"
  quantityBags       Int
  pricePerBag        Float
  bagSizeKg          Int?
  status             String              @default("ACTIVE") // ACTIVE, CLOSED
  createdAt          DateTime            @default(now())
  farmer             Farmer              @relation(fields: [farmerId], references: [id])
  qualityAssessments QualityAssessment[] @relation("ListingQuality")

  @@index([farmerId])
}

model BuyerDemand {
  id           String    @id @default(cuid())
  buyerId      String
  product      String
  quantityBags Int
  pricePerBag  Float?
  location     String
  status       String    @default("ACTIVE") // ACTIVE, CLOSED
  createdAt    DateTime  @default(now())
  buyer        Buyer     @relation(fields: [buyerId], references: [id])
  bagSize      String?
  startDate    DateTime?
  endDate      DateTime?

  @@index([buyerId])
}

model Conversation {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  messages      Message[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderType     String // "FARMER" | "BUYER"
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model B2CPayout {
  id                       String      @id @default(cuid())
  transactionId            String      @unique
  transaction              Transaction @relation(fields: [transactionId], references: [id])
  conversationId           String? // Safaricom ConversationID
  originatorConversationID String? // Safaricom OriginatorConversationID
  amount                   Float
  status                   String      @default("PENDING") // PENDING, SUCCESS, FAILED
  mpesaRef                 String? // M-PESA Transaction ID if successful
  failureReason            String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String // Generic ID (Farmer ID or Buyer ID)
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())
}

// --- V2-1: AI Market Intelligence ---
enum AIRecommendation {
  SELL
  WAIT
  BUY
  HOLD
}

model MarketPrediction {
  market          String?
  county          String?
  commodity       String?
  horizonDays     Int?
  lowerBound      Float?
  upperBound      Float?
  modelVersionId  String?
  modelVersion    ModelVersion?    @relation(fields: [modelVersionId], references: [id])
  id              String           @id @default(cuid())
  crop            String
  region          String
  horizon         String
  currentPrice    Float
  predictedPrice  Float
  confidenceScore Int
  recommendation  AIRecommendation
  explanation     String?          @db.Text
  generatedAt     DateTime         @default(now())

  @@unique([crop, region, horizon])
}

enum AIUserType {
  FARMER
  BUYER
  ADMIN
  TRANSPORT
}

enum AIInsightType {
  PRICE_PREDICTION
  DEMAND_FORECAST
  MARKET_ALERT
}

model AIInsight {
  id        String        @id @default(cuid())
  userId    String
  userType  AIUserType
  type      AIInsightType
  title     String
  body      String        @db.Text
  data      Json?
  read      Boolean       @default(false)
  createdAt DateTime      @default(now())

  farmer Farmer? @relation("FarmerAIInsights", fields: [userId], references: [id], map: "AIInsight_farmerId_fkey")
  buyer  Buyer?  @relation("BuyerAIInsights", fields: [userId], references: [id], map: "AIInsight_buyerId_fkey")
}

// --- V2-2: Weather Intelligence ---
model WeatherData {
  id        String   @id @default(cuid())
  county    String   @unique
  data      Json?
  advisory  String?  @db.Text
  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum WeatherSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  WARNING
}

model WeatherAlert {
  id        String          @id @default(cuid())
  county    String
  countyId  String?
  type      String
  status    String          @default("ACTIVE")
  severity  WeatherSeverity
  message   String          @db.Text
  createdAt DateTime        @default(now())

  countyRel         County?            @relation("WeatherAlertCounty", fields: [countyId], references: [id])
  transportBookings TransportBooking[] @relation("TransportWeatherAlerts")

  @@unique([county, type])
}

model WeatherHistory {
  id        String   @id @default(cuid())
  county    String
  date      DateTime
  temp      Float?
  humidity  Float?
  rainMm    Float?
  windSpeed Float?
  condition String?

  @@unique([county, date])
}

// --- V2-3: Digital Wallet + Ledger ---
enum WalletType {
  USER
  ESCROW
  PLATFORM
}

model Wallet {
  id            String     @id @default(cuid())
  type          WalletType @default(USER)
  farmerId      String?    @unique
  buyerId       String?    @unique
  providerId    String?    @unique
  balance       Float      @default(0)
  currency      String     @default("KES")
  lockedBalance Float      @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  farmer      Farmer?             @relation("FarmerWallet", fields: [farmerId], references: [id])
  buyer       Buyer?              @relation("BuyerWallet", fields: [buyerId], references: [id])
  provider    TransportProvider?  @relation("ProviderWallet", fields: [providerId], references: [id])
  entries     LedgerEntry[]
  withdrawals WithdrawalRequest[]
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

model LedgerEntry {
  id                   String          @id @default(cuid())
  walletId             String
  type                 LedgerEntryType
  amount               Float
  currency             String          @default("KES")
  description          String
  reference            String?
  balanceAfter         Float
  relatedTransactionId String?
  relatedContractId    String?
  createdAt            DateTime        @default(now())

  wallet      Wallet       @relation(fields: [walletId], references: [id])
  transaction Transaction? @relation(fields: [relatedTransactionId], references: [id])

  @@index([walletId])
  @@index([relatedTransactionId])
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model WithdrawalRequest {
  id          String           @id @default(cuid())
  walletId    String
  amount      Float
  mpesaPhone  String
  status      WithdrawalStatus @default(PENDING)
  mpesaRef    String?
  processedAt DateTime?
  createdAt   DateTime         @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
}

// --- V2-4: Digital Contracts + Negotiation ---
model ContractTemplate {
  contracts Contract[]
  id        String     @id @default(cuid())
  name      String
  content   String     @db.Text
  version   Int        @default(1)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
}

enum NegotiationActor {
  SELLER
  BUYER
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
}

model NegotiationOffer {
  id            String           @id @default(cuid())
  transactionId String
  actor         NegotiationActor
  pricePerUnit  Float
  quantity      Int
  terms         String?          @db.Text
  status        OfferStatus      @default(PENDING)
  createdAt     DateTime         @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  FULFILLED
  DISPUTED
  CANCELLED
  EXECUTED
  VOIDED
}

model Contract {
  id              String         @id @default(cuid())
  transactionId   String         @unique
  templateId      String?
  sellerId        String
  buyerId         String
  quantity        Int
  pricePerUnit    Float
  totalValue      Float
  terms           Json?
  paymentTerms    String?        @db.Text
  transportTerms  String?        @db.Text
  status          ContractStatus @default(DRAFT)
  verificationId  String         @unique @default(cuid())
  farmerSigned    Boolean        @default(false)
  buyerSigned     Boolean        @default(false)
  farmerSignedAt  DateTime?
  buyerSignedAt   DateTime?
  farmerSignature String?
  buyerSignature  String?
  pdfUrl          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  transaction Transaction       @relation(fields: [transactionId], references: [id])
  seller      Farmer            @relation("ContractSeller", fields: [sellerId], references: [id])
  buyer       Buyer             @relation("ContractBuyer", fields: [buyerId], references: [id])
  template    ContractTemplate? @relation(fields: [templateId], references: [id])
}

// --- V2-5: Transport Marketplace ---
model TransportProvider {
  id            String  @id @default(cuid())
  name          String
  phone         String  @unique
  passwordHash  String?
  email         String? @unique
  contactPerson String?
  nationalId    String?
  baseLocation  String?
  countyId      String?
  ratePerKm     Float?

  verificationStatus String    @default("PENDING")
  verificationNotes  String?   @db.Text
  verifiedAt         DateTime?
  verifiedBy         String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  language  String   @default("en")

  county                 County?                 @relation(fields: [countyId], references: [id])
  wallet                 Wallet?                 @relation("ProviderWallet")
  notificationPreference NotificationPreference?
  bookings               TransportBooking[]
  notifications          Notification[]
  vehicles               TransportVehicle[]
  requests               TransportRequest[]
  subscriptions          Subscription[]
  smartshambaId          String?                 @unique
  licenseNumber          String?
  pin                    String?
  pinFailedAttempts      Int                     @default(0)
  pinLockedUntil         DateTime?
}

enum TransportRequestStatus {
  REQUESTED
  MATCHED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum TransportBookingStatus {
  REQUESTED
  MATCHED
  ACCEPTED
  LOADED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
}

enum BookedByType {
  FARMER
  BUYER
}

model TransportRequest {
  id                 String                 @id @default(cuid())
  transactionId      String?                @unique
  groupTransactionId String?
  requestedById      String
  requestedByType    BookedByType
  providerId         String?
  pickupLocation     String
  dropoffLocation    String
  quantityBags       Int
  status             TransportRequestStatus @default(REQUESTED)
  requestedPickupAt  DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  transaction      Transaction?       @relation(fields: [transactionId], references: [id])
  groupTransaction GroupTransaction?  @relation(fields: [groupTransactionId], references: [id])
  provider         TransportProvider? @relation(fields: [providerId], references: [id])
  booking          TransportBooking?  @relation("RequestToBooking")
}

model TransportBooking {
  id                 String                 @id @default(cuid())
  transactionId      String?                @unique
  groupTransactionId String?
  requestId          String?                @unique
  providerId         String
  vehicleId          String?
  pickupCountyId     String?
  dropoffCountyId    String?
  weatherAlertId     String?
  weatherOverride    Boolean                @default(false)
  farmerId           String
  pickupLocation     String
  dropoffLocation    String
  distanceKm         Float
  cost               Float
  grossCost          Float?
  platformFee        Float?
  providerPayout     Float?
  commissionRate     Float?
  bookedById         String
  bookedByType       BookedByType
  status             TransportBookingStatus @default(REQUESTED)
  financialSettled   Boolean                @default(false)
  isHalted           Boolean                @default(false)
  haltReason         String?
  bookedAt           DateTime               @default(now())
  completedAt        DateTime?
  createdAt          DateTime               @default(now())

  transaction      Transaction?              @relation(fields: [transactionId], references: [id])
  groupTransaction GroupTransaction?         @relation("TransportBookings", fields: [groupTransactionId], references: [id])
  provider         TransportProvider         @relation(fields: [providerId], references: [id])
  vehicle          TransportVehicle?         @relation(fields: [vehicleId], references: [id])
  pickupCounty     County?                   @relation("TransportPickupCounty", fields: [pickupCountyId], references: [id])
  dropoffCounty    County?                   @relation("TransportDropoffCounty", fields: [dropoffCountyId], references: [id])
  weatherAlert     WeatherAlert?             @relation("TransportWeatherAlerts", fields: [weatherAlertId], references: [id])
  farmer           Farmer                    @relation(fields: [farmerId], references: [id])
  request          TransportRequest?         @relation("RequestToBooking", fields: [requestId], references: [id])
  events           DeliveryEvent[]
  allocations      TransportCostAllocation[]
}

model TransportVehicle {
  id                 String   @id @default(cuid())
  providerId         String
  registrationNumber String   @unique
  vehicleType        String
  capacityBags       Int
  status             String   @default("AVAILABLE")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  provider TransportProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bookings TransportBooking[]
}

model TransportCostAllocation {
  id            String   @id @default(cuid())
  bookingId     String
  farmerId      String
  bagsAllocated Int
  shareAmount   Float
  isSettled     Boolean  @default(false)
  createdAt     DateTime @default(now())

  booking TransportBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  farmer  Farmer           @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([farmerId])
}

model DeliveryEvent {
  id        String   @id @default(cuid())
  bookingId String
  eventType String
  notes     String?
  location  String?
  createdAt DateTime @default(now())

  booking TransportBooking @relation(fields: [bookingId], references: [id])
}

// --- V2-6: Trust / Reputation Engine ---
enum TrustUserType {
  FARMER
  BUYER
  TRANSPORT
  GROUP
}

model TrustScore {
  id            String        @id @default(cuid())
  userId        String
  userType      TrustUserType
  score         Float
  level         String
  breakdown     Json
  computedAt    DateTime      @default(now())
  nextComputeAt DateTime?

  @@unique([userId, userType])
}

model TrustEvent {
  id          String        @id @default(cuid())
  userId      String
  userType    TrustUserType
  eventType   String
  impact      Float
  description String?       @db.Text
  relatedId   String?
  createdAt   DateTime      @default(now())
}

// --- V2-7: GIS + Geofencing ---
enum GeofenceType {
  OPERATIONAL
  RESTRICTED
  WEATHER
}

model Geofence {
  id        String       @id @default(cuid())
  name      String
  county    String?
  type      GeofenceType
  geometry  Json
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
}

model Warehouse {
  iotDevices       IoTDevice[]
  id               String       @id @default(cuid())
  name             String
  county           String?
  location         String?
  latitude         Float?
  longitude        Float?
  capacityBags     Int?
  pricePerBag      Float?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  groupId          String?
  houseNumber      String?
  size             String?
  whatsappLink     String?
  whatsappApproved Boolean      @default(false)
  group            FarmerGroup? @relation("WarehouseGroup", fields: [groupId], references: [id])
}

// --- V2-8: Event-Driven Architecture ---
enum EventOutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model EventOutbox {
  id            String            @id @default(cuid())
  eventType     String
  aggregateId   String
  payload       Json
  status        EventOutboxStatus @default(PENDING)
  attempts      Int               @default(0)
  lastError     String?           @db.Text
  processedAt   DateTime?
  createdAt     DateTime          @default(now())
  eventKey      String?           @unique
  version       Int               @default(1)
  nextAttemptAt DateTime?

  @@index([status, createdAt])
}

// --- SmartShamba RBAC: Executive Staff ---
enum StaffRole {
  CEO
  CTO
  CFO
  PM
}

model Staff {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  role         StaffRole
  passwordHash String
  active       Boolean   @default(true)
  mfaEnabled   Boolean   @default(false)
  totpSecret   String? // Encrypted or plaintext TOTP secret
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]
}

// --- SmartShamba AI Assistant Persistence ---
model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  role      String // "FARMER" | "BUYER" | "ADMIN"
  title     String?
  createdAt DateTime    @default(now())
  messages  AiMessage[]
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String // "user" | "ai"
  content        String         @db.Text
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// --- V2-9: Analytics & BI ---
model DailyMetric {
  id        String   @id @default(cuid())
  date      DateTime @unique
  metrics   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- V2.1: Subscriptions ---

enum SubscriptionType {
  WEATHER_ALERTS
  BUYER_DEMAND_ALERTS
  PEST_ALERTS
  BUYER_VERIFICATION
  TRANSPORT_PRIORITY_ALERTS
}

enum SubscriptionBillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING_PAYMENT
}

model Subscription {
  id     String             @id @default(cuid())
  type   SubscriptionType
  status SubscriptionStatus @default(PENDING_PAYMENT)

  farmerId   String?
  buyerId    String?
  providerId String?

  priceKsh      Float
  billingPeriod SubscriptionBillingPeriod?

  startedAt DateTime?
  expiresAt DateTime?

  mpesaRef          String?
  checkoutRequestId String? @unique

  createdAt DateTime @default(now())

  farmer   Farmer?            @relation(fields: [farmerId], references: [id])
  buyer    Buyer?             @relation(fields: [buyerId], references: [id])
  provider TransportProvider? @relation(fields: [providerId], references: [id])

  @@index([farmerId])
  @@index([buyerId])
  @@index([status])
}

// --- V2.1: Global Identity Registry ---

model SmartShambaIdentity {
  id            String   @id @default(cuid())
  smartshambaId String   @unique
  userType      String // "FARMER", "BUYER", "TRANSPORT"
  entityId      String
  createdAt     DateTime @default(now())

  @@index([userType, entityId])
}

// --- V3 PHASE 0: MAVUNOWISE FOUNDATION ---

enum CropCycleStatus {
  ACTIVE
  HARVESTED
  CLOSED
}

model FarmCropCycle {
  id                  String          @id @default(cuid())
  farmerId            String
  crop                String
  season              String
  acreage             Float?
  plantingDate        DateTime?
  expectedHarvestDate DateTime?
  actualHarvestDate   DateTime?
  expectedYieldBags   Int?
  actualYieldBags     Int?
  status              CropCycleStatus @default(ACTIVE)
  createdAt           DateTime        @default(now())

  farmer      Farmer          @relation(fields: [farmerId], references: [id])
  costEntries FarmCostEntry[]
  farmBatches FarmBatch[]

  @@index([farmerId])
}

enum FarmCostCategory {
  SEED
  FERTILIZER
  LABOUR
  CHEMICALS
  TRANSPORT
  HARVESTING
  STORAGE
  OTHER
}

model FarmCostEntry {
  id          String           @id @default(cuid())
  cropCycleId String
  category    FarmCostCategory
  description String?
  amountKes   Float
  quantity    Float?
  unit        String?
  date        DateTime
  source      String           @default("FARMER_REPORTED")
  createdAt   DateTime         @default(now())

  cropCycle FarmCropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)

  @@index([cropCycleId])
}

model MarketPriceObservation {
  id                String   @id @default(cuid())
  observationKey    String   @unique // Deterministic idempotency key
  source            String
  sourceRecordId    String?
  county            String
  market            String
  commodity         String
  classification    String?
  grade             String?
  wholesaleKesPerKg Float?
  retailKesPerKg    Float?
  supplyVolume      Float?
  observedAt        DateTime
  importedAt        DateTime @default(now())

  @@index([county, commodity, observedAt])
}

model FarmBatch {
  id                  String   @id @default(cuid())
  cropCycleId         String
  batchReference      String   @unique
  quantityBags        Int
  bagSizeKg           Int
  qualityAssessmentId String?  @unique
  producedAt          DateTime
  status              String   @default("PENDING")

  cropCycle         FarmCropCycle      @relation(fields: [cropCycleId], references: [id])
  qualityAssessment QualityAssessment? @relation(fields: [qualityAssessmentId], references: [id])
  dealEvidence      DealEvidence?
  provenanceAnchors ProvenanceAnchor[]

  @@index([cropCycleId])
}

model DealEvidence {
  id            String   @id @default(cuid())
  batchId       String   @unique
  photoRef      String?
  weightKg      Float?
  moistureLevel Float?
  qualityNote   String?
  capturedBy    String
  capturedAt    DateTime @default(now())
  evidenceHash  String

  batch FarmBatch @relation(fields: [batchId], references: [id])
}

enum AnchorChain {
  POLYGON
}

model ProvenanceAnchor {
  id              String      @id @default(cuid())
  batchId         String
  certificateHash String
  chain           AnchorChain @default(POLYGON)
  transactionHash String?
  blockNumber     Int?
  anchoredAt      DateTime?
  schemaVersion   String

  batch FarmBatch @relation(fields: [batchId], references: [id])

  @@index([batchId])
}

model IoTDevice {
  id           String    @id @default(cuid())
  warehouseId  String
  deviceType   String
  serialNumber String    @unique
  status       String    @default("ACTIVE")
  lastSeenAt   DateTime?
  metadata     Json?

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  readings  SensorReading[]

  @@index([warehouseId])
}

enum SensorMetric {
  MOISTURE
  TEMPERATURE
  HUMIDITY
}

model SensorReading {
  id         String       @id @default(cuid())
  deviceId   String
  metric     SensorMetric
  value      Float
  unit       String
  recordedAt DateTime

  device IoTDevice @relation(fields: [deviceId], references: [id])

  @@index([deviceId, recordedAt])
}

model DataSource {
  id               String  @id @default(cuid())
  name             String
  sourceType       String
  licenseNotes     String? @db.Text
  accessMethod     String?
  refreshFrequency String?
  active           Boolean @default(true)
}

enum ModelVersionStatus {
  STAGING
  PRODUCTION
  ARCHIVED
}

model ModelVersion {
  id                     String             @id @default(cuid())
  name                   String
  version                String
  target                 String
  trainingDatasetVersion String?
  metrics                Json?
  artifactLocation       String?
  deployedAt             DateTime?
  status                 ModelVersionStatus @default(STAGING)

  marketPredictions MarketPrediction[]
}
